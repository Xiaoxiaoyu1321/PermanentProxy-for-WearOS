<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="@dimen/box_inset_layout_padding"
    tools:context=".MainActivity"
    tools:deviceIds="wear">

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/main_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_horizontal"
                android:text="@string/status"
                android:textAppearance="@android:style/TextAppearance.Material.Medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/proxy_not_enabled"
                android:textAppearance="@android:style/TextAppearance.Material.Body1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="@string/current_ext"
                android:textAppearance="@android:style/TextAppearance.Material.Medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ext_ip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/loading"
                android:textAppearance="@android:style/TextAppearance.Material.Body1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="@string/privileged_access"
                android:textAppearance="@android:style/TextAppearance.Material.Medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/privilege_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/loading"
                android:textAppearance="@android:style/TextAppearance.Material.Body1" />

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/grey" />

            <TextView
                android:id="@+id/show_me_how"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:enabled="true"
                android:gravity="center_vertical"
                android:minHeight="45dp"
                android:text="@string/setup_shizuku"
                android:textAppearance="@android:style/TextAppearance.Material.Body1" />

            <TextView
                android:id="@+id/request_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:enabled="true"
                android:gravity="center_vertical"
                android:minHeight="45dp"
                android:visibility="gone"
                android:text="@string/grant_shizuku_permission"
                android:textAppearance="@android:style/TextAppearance.Material.Body1" />

            <TextView
                android:id="@+id/set_proxy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:enabled="false"
                android:gravity="center_vertical"
                android:minHeight="45dp"
                android:visibility="gone"
                android:text="@string/set_proxy"
                android:textAppearance="@android:style/TextAppearance.Material.Body1" />

            <TextView
                android:id="@+id/disable_proxy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:enabled="true"
                android:gravity="center_vertical"
                android:minHeight="45dp"
                android:text="@string/disable_proxy"
                android:textAppearance="@android:style/TextAppearance.Material.Body1"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/reboot_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minHeight="45dp"
                android:visibility="gone"
                android:text="@string/reboot_after_disable"
                android:textAppearance="@android:style/TextAppearance.Material.Body1" />

            <TextView
                android:id="@+id/proxy_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:enabled="false"
                android:gravity="center_vertical"
                android:minHeight="45dp"
                android:text="@string/proxy_address"
                android:textAppearance="@android:style/TextAppearance.Material.Body1"
                android:visibility="gone" />

            <EditText
                android:id="@+id/address_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/address"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:minHeight="45dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/proxy_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:enabled="false"
                android:gravity="center_vertical"
                android:minHeight="45dp"
                android:text="@string/proxy_port"
                android:textAppearance="@android:style/TextAppearance.Material.Body1"
                android:visibility="gone" />

            <EditText
                android:id="@+id/port_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/port"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLines="1"
                android:minHeight="45dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/donate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="45dp"
                android:text="@string/donate"
                android:textAppearance="@android:style/TextAppearance.Material.Body1" />

            <TextView
                android:id="@+id/old_watch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="64dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="45dp"
                android:text="@string/manual_setup"
                android:textAppearance="@android:style/TextAppearance.Material.Body1" />
        </LinearLayout>

    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
